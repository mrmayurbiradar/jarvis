      "parameters": {
        "jsCode": "// Summarise a week's worth of events posted by the JARVIS agent.\nconst input = $input.first().json;\nconst payload = input && input.payload ? input.payload : input;\nconst events = Array.isArray(payload && payload.events) ? payload.events : [];\nconst by_day = events.reduce((acc, e) => {\n  const day = (e && e.day) || 'unknown';\n  acc[day] = (acc[day] || 0) + 1;\n  return acc;\n}, {});\nreturn [{ json: {\n  digest_date: new Date().toISOString().slice(0, 10),\n  total_events: events.length,\n  by_day\n} }];\n"
      },
