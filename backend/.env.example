# Copy to .env (never commit). All variables are optional.
# Deployment: local | hybrid | remote
JARVIS_DEPLOYMENT_MODE=local
JARVIS_DEBUG=false

# Local worker shell/app allowlists (default-deny). JSON arrays.
# Empty (or unset) = nothing runs.
JARVIS_ALLOWLIST_COMMANDS=["echo"]
JARVIS_ALLOWLIST_APPS=[]

# Workflow layer (matrix row C6): n8n for Hybrid/Remote.
# n8n runs via `docker compose up` (infra/docker-compose.yml), port 5678.
# Leave JARVIS_N8N_BASE_URL empty to disable the workflow layer entirely.
# The API key is created in the n8n UI (Settings → API), then exported here.
# JARVIS_N8N_BASE_URL=http://127.0.0.1:5678
# JARVIS_N8N_API_KEY=
# Webhook paths the agent may trigger (default-deny, like the app allowlist):
JARVIS_ALLOWLIST_WEBHOOKS=[]

# Gate 3 of ADR-0005: block high-risk tools (shell) until interactive approval.
# The client UI will wire the approval prompt; leave false until then.
JARVIS_REQUIRE_APPROVAL=false

# Provider layer (matrix C7). "mock" needs no API key.
# JARVIS_LLM_PROVIDER=mock|openai
# JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
# JARVIS_OPENAI_MODEL=gpt-4o-mini
# JARVIS_OPENAI_API_KEY=sk-...

# Local store (SQLite). Defaults to the OS data dir — override for tests/demos.
# JARVIS_DB_PATH=

# Path overrides — defaults resolve via platformdirs per OS (never hardcoded).
# JARVIS_DATA_DIR=
# JARVIS_CONFIG_DIR=
# JARVIS_LOG_DIR=

# Secrets live here or in the OS keychain — never in source code.
# JARVIS_WORKER_TOKEN=